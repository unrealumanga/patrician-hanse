    "@typeonce/oxlint-plugin-ritmo": "^0.27.0",
    "@typeonce/ritmo-devtools": "^0.27.0",
    "@types/three": "^0.187.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}

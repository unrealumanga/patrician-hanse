{
  "name": "patrician-hanse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "package": "node scripts/package-portable.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ritmo": "ritmo-devtools lint src/lint.ts",
